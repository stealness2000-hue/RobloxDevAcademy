{
  "name": "lumora-academy",
  "productName": "Lumora Academy",
  "version": "0.6.0",
  "description": "Learn to code Roblox games with Luau, from zero. Also C++ and Java.",
  "author": "Lumora Academy",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"node scripts/build-electron.mjs && wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && node scripts/package-win.mjs",
    "test:e2e": "node tests/e2e/acceptance.mjs",
    "tour": "node tests/e2e/tour.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@luau-rs/luau": "0.739.0",
    "lucide-react": "1.72.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sql.js": "1.16.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "cross-env": "10.1.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "academy.lumora.app",
    "productName": "Lumora Academy",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@luau-rs/luau/**",
      "node_modules/sql.js/dist/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Lumora Academy",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Lumora-Academy-Setup.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
